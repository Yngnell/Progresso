# Frontend environment variables (Vite).
# Leave blank in development — the Vite dev server proxies /api to the backend.
# In production, set this to your deployed backend URL, e.g. https://api.yoursite.com
VITE_API_URL=

# Letterhead of the printable Accomplishment Report ("Province of ...", "City of ...").
# Leave blank to use the defaults: Cavite / Bacoor / Salinas 1.
VITE_REPORT_PROVINCE=
VITE_REPORT_CITY=
VITE_REPORT_BARANGAY=
