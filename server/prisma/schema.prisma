// SK Project Monitoring System — Prisma schema (PostgreSQL)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  CHAIRMAN
  OFFICIAL // an SK official's own account (limited admin panel)
  VIEWER
}

// The SK project process. Each project moves one stage at a time:
//   PENDING_APPROVAL -> APPROVED -> PURCHASING -> FUND_RELEASE -> IMPLEMENTATION -> LIQUIDATION -> COMPLETED
// REJECTED: the Barangay Chairman rejected the request (with remarks).
// ON_HOLD: paused; it resumes at the stage it was held from (heldFromStatus).
// ARCHIVED: a completed project filed away (read only).
enum ProjectStatus {
  PENDING_APPROVAL
  APPROVED
  PURCHASING
  FUND_RELEASE
  IMPLEMENTATION
  LIQUIDATION
  COMPLETED
  REJECTED
  ON_HOLD
  ARCHIVED
}

enum EventType {
  MEETING
  SESSION
  ACTIVITY
  APPOINTMENT
}

// Present: scanned the event's QR code. Absent: an SK official who had not scanned by
// the time the event ended (recorded automatically).
enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

// ---------- Models ----------

// App users. Admins AND registered public viewers live here.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  phone        String?
  // Where project alerts are emailed (e.g. a Gmail address). Empty = in-app alerts only.
  notifyEmail  String?
  // Email verification: the login email (viewers confirm it at sign-up) and the alert
  // email each need a confirmed 6-digit code before they are trusted.
  emailVerifiedAt       DateTime?
  notifyEmailVerifiedAt DateTime?
  verifyCodeHash        String?   // bcrypt hash of the pending 6-digit code
  verifyCodeExpires     DateTime?
  verifyCodeFor         String?   // LOGIN | NOTIFY: which address the code confirms
  verifyAttempts        Int       @default(0)
  verifyCodeSentAt      DateTime?
  // Residents can opt in to emails about news, events and project milestones at sign-up.
  receiveUpdates        Boolean   @default(false)
  updatesSince          DateTime? // they only get alerts created after they opted in
  unsubscribeToken      String?   @unique
  // A new login email waiting for its emailed code (My Account → change email)
  pendingEmail          String?
  // Set when this account belongs to an SK official in the directory
  officialId            String?   @unique
  official              Official? @relation(fields: [officialId], references: [id], onDelete: SetNull)
  // Forgot password: sha256 of the emailed one-time token, valid for 15 minutes
  resetTokenHash        String?   @unique
  resetTokenExpires     DateTime?
  resetTokenSentAt      DateTime?
  // Login history: lastLoginAt is this session; previousLoginAt is shown as "last login"
  lastLoginAt           DateTime?
  previousLoginAt       DateTime?
  // The SK Admin account can act as an official (e.g. the SK Secretary): the header then
  // shows that official's name and position. Not a link: the official keeps their own account.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  news         News[]    // articles authored (admin)
  createdProjects  Project[] @relation("ProjectCreator")
  reviewedProjects Project[] @relation("ProjectReviewer")
  uploadedDocuments ProjectDocument[]
  stageChanges      ProjectStageLog[]

  @@index([role])
}

// Directory of SK / barangay officials (no login required).
model Official {
  id           String    @id @default(uuid())
  name         String
  position     String
  committee    String?
  contact      String?
  termStart    DateTime?
  termEnd      DateTime?
  bio          String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  events       Event[]   @relation("EventOrganizer")
  projects     Project[] // many-to-many team membership
  account      User?     // the official's own login, if one was created
  attendance   AttendanceRecord[]
}

// Core monitoring entity: an SK project / program.
model Project {
  id             String        @id @default(uuid())
  title          String
  description    String?
  category       String?
  status         ProjectStatus @default(PENDING_APPROVAL)
  budget         Decimal       @default(0) @db.Decimal(12, 2)
  // The ABYIP (Annual Barangay Youth Investment Program) item the project is funded under.
  abyipItem      String?
  // Liquidation: what was spent, and what goes back (budget - spent, 2 decimals).
  amountSpent    Decimal?      @db.Decimal(12, 2)
  amountReturned Decimal?      @db.Decimal(12, 2)
  // The Barangay Chairman's remarks when the request is rejected.
  rejectionRemarks String?
  // Set when the SK Admin submits the request (with its documents) to the Barangay Chairman.
  submittedAt    DateTime?
  // The stage an On Hold project returns to when it is resumed.
  heldFromStatus ProjectStatus?
  progress       Int           @default(0) // legacy; progress is now computed
  // How progress is measured: DATETIME (elapsed share of the start-to-end time) or
  // ATTENDEE (people who checked in at the linked events / targetAttendees)
  progressType    String       @default("DATETIME")
  targetAttendees Int?
  startDate      DateTime?
  endDate        DateTime?
  location       String?
  coverImageUrl  String?
  createdById    String
  createdBy      User          @relation("ProjectCreator", fields: [createdById], references: [id])
  // Barangay Chairman review: PENDING (awaiting) | APPROVED | RETURNED (needs revision)
  approvalState  String        @default("PENDING")
  reviewedById   String?
  reviewedBy     User?         @relation("ProjectReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewRemarks  String?
  // SK council approval recorded when the project is marked completed
  councilApprovedOn   DateTime?
  councilResolutionNo String?
  cancelReason        String?
  // Archive: an approved deletion request moves the project here instead of erasing it.
  archivedAt          DateTime?
  // An On Hold project moved to Archives (On Hold tab): view only.
  holdArchivedAt      DateTime?
  archivedReason      String?
  archivedByName      String?
  // "Prepared by" on the project proposal form (snapshots of the official's name/position)
  proposedByName      String?
  proposedByPosition  String?
  officials      Official[]    // team
  expenses       Expense[]
  events         Event[]
  requestItems   ProjectRequestItem[]
  notifications  Notification[]
  deletionRequests DeletionRequest[]
  photos         Photo[]
  documents      ProjectDocument[]
  stageLogs      ProjectStageLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

// One row of the project's "Itemized List of Purchase Request (PR)" sheet.
// The project budget is the total of these amounts.
model ProjectRequestItem {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prNo         String?
  prDate       DateTime?
  requestedBy  String?
  amount       Decimal   @default(0) @db.Decimal(12, 2)
  displayOrder Int       @default(0)

  @@index([projectId])
}

// A project can only be deleted after the chairman approves a request that
// states a reason. Rows are kept after the project is gone (projectId becomes
// null; projectTitle and names are snapshots) so there is always a record.
model DeletionRequest {
  id              String    @id @default(uuid())
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectTitle    String
  reason          String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | WITHDRAWN
  requestedById   String?
  requestedByName String
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  reviewRemarks   String?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([projectId])
}

// A single expense line item under a project.
model Expense {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item      String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  // A manual deduction from the budget is backed by an uploaded receipt (image or PDF).
  voucherNo    String?
  receiptFile  String? // stored file name inside server/uploads/receipts
  receiptName  String? // original file name, shown to the user
  receiptType  String? // MIME type
  createdAt DateTime @default(now())
}

// In-app alerts about a project: progress milestones and approaching/passed end date.
// One row per project and type, so each alert fires once. readByIds lists the users
// who have already opened it.
model Notification {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String   // ENDING_3D | ENDING_1D | REQUEST_SUBMITTED/APPROVED/REJECTED (projects) | EVENT_1D | EVENT_1H (calendar)
  title     String
  message   String
  readByIds String[] @default([])
  // Who sees it: empty = the whole SK side; "ADMIN" or "CHAIRMAN" = only that kind of account
  audience  String?
  emailedAt DateTime? // set once the alert has been emailed to everyone who opted in
  viewerEmailedAt DateTime? // same, for the residents who ticked "email me updates"
  createdAt DateTime @default(now())

  @@unique([projectId, type])
  @@unique([eventId, type])
  @@index([createdAt])
}

// Calendar entry: meeting, session, activity, or appointment.
model Event {
  id               String    @id @default(uuid())
  title            String
  type             EventType @default(MEETING)
  description      String?
  startAt          DateTime
  endAt            DateTime?
  location         String?
  meetingLink      String?
  organizerId      String?
  organizer        Official? @relation("EventOrganizer", fields: [organizerId], references: [id])
  relatedProjectId String?
  relatedProject   Project?  @relation(fields: [relatedProjectId], references: [id])
  // Attendance QR (SK Chairperson): one code per event, valid only inside its window.
  // Regenerating gives a new token, so the old QR stops working.
  qrToken          String?   @unique
  qrActive         Boolean   @default(false)
  qrValidFrom      DateTime?
  qrValidUntil     DateTime?
  attendance       AttendanceRecord[]
  notifications    Notification[]
  photos           Photo[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([startAt])
}

// One attendance record per participant per event.
model AttendanceRecord {
  id          String           @id @default(uuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant String           // display name of attendee
  // The SK official marked Present (from the QR attendance page) or Absent.
  officialId  String?
  official    Official?        @relation(fields: [officialId], references: [id], onDelete: SetNull)
  userId      String?          // older check-ins made with an account
  status      AttendanceStatus @default(PRESENT)
  timeIn      DateTime?
  createdAt   DateTime         @default(now())

  // One record per official (and per older account) per event
  @@unique([eventId, officialId])
  @@unique([eventId, userId])
}

// Public news / announcements shown on the home page.
model News {
  id            String     @id @default(uuid())
  title         String
  category      String?
  excerpt       String?
  content       String
  coverImageUrl String?
  authorId      String
  author        User       @relation(fields: [authorId], references: [id])
  status        NewsStatus @default(DRAFT)
  publishedAt   DateTime?
  views         Int        @default(0)
  isFeatured    Boolean    @default(false)
  emailedAt     DateTime?  // set once subscribers were emailed about this article
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
}

// A sign-up waiting for its emailed code. The User row is only created once the code is
// verified, so nobody can register with an address they do not own.
model PendingSignup {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  phone          String?
  passwordHash   String
  receiveUpdates Boolean  @default(false)
  codeHash       String
  codeExpires    DateTime
  attempts       Int      @default(0)
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
// A progress photo of a project or an event, shown on the public site.
// The documents each stage needs before the project can move on (seeded; see seed.js).
// minFiles: how many checked uploads the document needs (e.g. at least 3 supplier canvasses).
model RequiredDocument {
  id           String        @id @default(uuid())
  stage        ProjectStatus
  name         String
  minFiles     Int           @default(1)
  displayOrder Int           @default(0)
  documents    ProjectDocument[]

  @@unique([stage, name])
  @@index([stage])
}

// One uploaded file for a required document of a project. The SK Admin checks it after
// reviewing it; a stage is complete when every required document has enough checked files.
model ProjectDocument {
  id                 String           @id @default(uuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requiredDocumentId String
  requiredDocument   RequiredDocument @relation(fields: [requiredDocumentId], references: [id])
  fileUrl            String           // stored file name inside uploads/receipts (served through the API)
  originalName       String
  mimeType           String
  isChecked          Boolean          @default(false)
  uploadedById       String?
  uploadedBy         User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt         DateTime         @default(now())

  @@index([projectId])
  @@index([requiredDocumentId])
}

// Every stage change of a project: who moved it, from where to where, and why.
model ProjectStageLog {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus  ProjectStatus?
  toStatus    ProjectStatus
  remarks     String?
  changedById String?
  changedBy   User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime       @default(now())

  @@index([projectId, changedAt])
}

// A progress photo of a project or an event, shown on the public site.
model Photo {
  id             String   @id @default(uuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  caption        String?
  fileName       String   // stored file name inside server/uploads/photos
  mimeType       String
  uploadedByName String
  uploadedById   String? // the uploader may delete their own picture
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([eventId])
}

// SK information and attendance defaults, edited by the SK Chairperson in Settings → System.
// A single row with id "sk".
model Setting {
  id                 String   @id @default("sk")
  barangayName       String   @default("Barangay Salinas 1, City of Bacoor, Cavite")
  skTerm             String   @default("2023-2026")
  logoFile           String?  // uploaded logo inside server/uploads/photos; empty = the SK seal
  logoType           String?
  qrDefaultBeforeMin Int      @default(30) // QR opens this many minutes before the start
  qrDefaultLengthMin Int?     // QR stays valid this many minutes; empty = until the event ends
  updatedAt          DateTime @updatedAt
}
