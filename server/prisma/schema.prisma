// SK Project Monitoring System — Prisma schema (PostgreSQL)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  CHAIRMAN
  OFFICIAL // an SK official's own account (limited admin panel)
  VIEWER
}

// The SK project process (Forms 3 to 9):
//   DRAFT -> PENDING (SK Admin submits) -> APPROVED | REJECTED | FOR_REVISION (Barangay Chairman)
//   FOR_REVISION -> PENDING (resubmitted); APPROVED -> ONGOING (started);
//   ONGOING -> COMPLETED (Form 8); APPROVED | ONGOING -> CANCELLED (Form 9).
// PROPOSED, PLANNING and ON_HOLD are from the earlier flow; they are kept in the type but no
// project uses them any more (existing projects were moved to the new statuses).
enum ProjectStatus {
  PROPOSED
  PLANNING
  ONGOING
  COMPLETED
  CANCELLED
  ON_HOLD
  DRAFT
  PENDING
  FOR_REVISION
  APPROVED
  REJECTED
}

enum EventType {
  MEETING
  SESSION
  ACTIVITY
  APPOINTMENT
}

// Present: scanned the event's QR code. Absent: an SK official who had not scanned by
// the time the event ended (recorded automatically).
enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

// ---------- Models ----------

// App users. Admins AND registered public viewers live here.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  phone        String?
  // Where project alerts are emailed (e.g. a Gmail address). Empty = in-app alerts only.
  notifyEmail  String?
  // Email verification: the login email (viewers confirm it at sign-up) and the alert
  // email each need a confirmed 6-digit code before they are trusted.
  emailVerifiedAt       DateTime?
  notifyEmailVerifiedAt DateTime?
  verifyCodeHash        String?   // bcrypt hash of the pending 6-digit code
  verifyCodeExpires     DateTime?
  verifyCodeFor         String?   // LOGIN | NOTIFY: which address the code confirms
  verifyAttempts        Int       @default(0)
  verifyCodeSentAt      DateTime?
  // Residents can opt in to emails about news, events and project milestones at sign-up.
  receiveUpdates        Boolean   @default(false)
  updatesSince          DateTime? // they only get alerts created after they opted in
  unsubscribeToken      String?   @unique
  // A new login email waiting for its emailed code (My Account → change email)
  pendingEmail          String?
  // Set when this account belongs to an SK official in the directory
  officialId            String?   @unique
  official              Official? @relation(fields: [officialId], references: [id], onDelete: SetNull)
  // Forgot password: sha256 of the emailed one-time token, valid for 15 minutes
  resetTokenHash        String?   @unique
  resetTokenExpires     DateTime?
  resetTokenSentAt      DateTime?
  // Login history: lastLoginAt is this session; previousLoginAt is shown as "last login"
  lastLoginAt           DateTime?
  previousLoginAt       DateTime?
  // The SK Admin account can act as an official (e.g. the SK Secretary): the header then
  // shows that official's name and position. Not a link: the official keeps their own account.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  news         News[]    // articles authored (admin)
  createdProjects  Project[] @relation("ProjectCreator")
  reviewedProjects Project[] @relation("ProjectReviewer")
  projectReviews   ProjectReview[]
  progressUpdates  ProgressUpdate[]
  expenses         Expense[] @relation("ExpenseCreator")

  @@index([role])
}

// Directory of SK / barangay officials (no login required).
model Official {
  id           String    @id @default(uuid())
  name         String
  position     String
  committee    String?
  contact      String?
  termStart    DateTime?
  termEnd      DateTime?
  bio          String?
  // Optional photo shown on the officials cards (stored in uploads/photos); none = the initial.
  photoFile    String?
  photoType    String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  events       Event[]   @relation("EventOrganizer")
  projects     Project[] // many-to-many team membership
  account      User?     // the official's own login, if one was created
  attendance   AttendanceRecord[]
}

// Core monitoring entity: an SK project / program.
model Project {
  id             String        @id @default(uuid())
  title          String
  description    String?
  category       String?
  status         ProjectStatus @default(DRAFT)
  budget         Decimal       @default(0) @db.Decimal(12, 2) // kept equal to estimatedCost
  progress       Int           @default(0) // current progress (0-100) from the latest Form 5 update
  // How progress is measured: DATETIME (elapsed share of the start-to-end time) or
  // ATTENDEE (people who checked in at the linked events / targetAttendees)
  progressType    String       @default("DATETIME")
  targetAttendees Int?
  startDate      DateTime?
  endDate        DateTime?
  location       String?
  coverImageUrl  String?
  createdById    String
  createdBy      User          @relation("ProjectCreator", fields: [createdById], references: [id])
  // Barangay Chairman review: PENDING (awaiting) | APPROVED | RETURNED (needs revision)
  approvalState  String        @default("PENDING")
  reviewedById   String?
  reviewedBy     User?         @relation("ProjectReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewRemarks  String?
  // SK council approval recorded when the project is marked completed
  councilApprovedOn   DateTime?
  councilResolutionNo String?
  cancelReason        String?
  // Archive: an approved deletion request moves the project here instead of erasing it.
  archivedAt          DateTime?
  // An On Hold project moved to Archives (On Hold tab): view only.
  holdArchivedAt      DateTime?
  archivedReason      String?
  archivedByName      String?
  // "Prepared by" on the project proposal form (snapshots of the official's name/position)
  proposedByName      String?
  proposedByPosition  String?
  // Form 3: Project Request
  abyipItemId         String?
  abyipItem           AbyipItem? @relation(fields: [abyipItemId], references: [id])
  objectives          String?
  targetParticipants  Int?
  estimatedCost       Decimal   @default(0) @db.Decimal(12, 2) // sum of the budget rows
  submittedAt         DateTime?
  approvedAt          DateTime?
  startedAt           DateTime?
  // Form 8: Project Completion
  actualEndDate         DateTime?
  actualParticipants    Int?
  accomplishmentSummary String?
  completedAt           DateTime?
  // Form 9: Project Cancellation (the reason is cancelReason)
  cancelDate          DateTime?
  cancelledAt         DateTime?
  budgetRows     ProjectBudgetRow[]
  reviews        ProjectReview[]
  progressUpdates ProgressUpdate[]
  attendance     AttendanceRecord[]
  officials      Official[]    // team
  expenses       Expense[]
  events         Event[]
  requestItems   ProjectRequestItem[]
  notifications  Notification[]
  deletionRequests DeletionRequest[]
  photos         Photo[]
  liquidationFiles LiquidationFile[]
  prFiles          PurchaseRequestFile[]
  checklistItems   ChecklistItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

// One row of the project's "Itemized List of Purchase Request (PR)" sheet.
// The project budget is the total of these amounts.
model ProjectRequestItem {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prNo         String?
  prDate       DateTime?
  requestedBy  String?
  amount       Decimal   @default(0) @db.Decimal(12, 2)
  displayOrder Int       @default(0)

  @@index([projectId])
}

// A project can only be deleted after the chairman approves a request that
// states a reason. Rows are kept after the project is gone (projectId becomes
// null; projectTitle and names are snapshots) so there is always a record.
model DeletionRequest {
  id              String    @id @default(uuid())
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectTitle    String
  reason          String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | WITHDRAWN
  requestedById   String?
  requestedByName String
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  reviewRemarks   String?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([projectId])
}

// A single expense line item under a project.
model Expense {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item      String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  // A manual deduction from the budget is backed by an uploaded receipt (image or PDF).
  voucherNo    String?
  receiptFile  String? // stored file name inside server/uploads/receipts
  receiptName  String? // original file name, shown to the user
  receiptType  String? // MIME type
  // Form 6: Expense (item is the description)
  category     String?
  supplier     String?
  fileId       String? // the receipt, kept in the project files
  file         LiquidationFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?   @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// In-app alerts about a project: progress milestones and approaching/passed end date.
// One row per project and type, so each alert fires once. readByIds lists the users
// who have already opened it.
model Notification {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String   // PROGRESS_50/75/90 | ENDING_3D | ENDING_1D (projects) | EVENT_1D | EVENT_1H (calendar)
  title     String
  message   String
  readByIds String[] @default([])
  // Who sees it: empty = the whole SK side; "SK_CHAIR" = only the SK Chairperson
  audience  String?
  emailedAt DateTime? // set once the alert has been emailed to everyone who opted in
  viewerEmailedAt DateTime? // same, for the residents who ticked "email me updates"
  createdAt DateTime @default(now())

  @@unique([projectId, type])
  @@unique([eventId, type])
  @@index([createdAt])
}

// Calendar entry: meeting, session, activity, or appointment.
model Event {
  id               String    @id @default(uuid())
  title            String
  type             EventType @default(MEETING)
  description      String?
  startAt          DateTime
  endAt            DateTime?
  location         String?
  meetingLink      String?
  organizerId      String?
  organizer        Official? @relation("EventOrganizer", fields: [organizerId], references: [id])
  relatedProjectId String?
  relatedProject   Project?  @relation(fields: [relatedProjectId], references: [id])
  // Attendance QR (SK Chairperson): one code per event, valid only inside its window.
  // Regenerating gives a new token, so the old QR stops working.
  qrToken          String?   @unique
  qrActive         Boolean   @default(false)
  qrValidFrom      DateTime?
  qrValidUntil     DateTime?
  attendance       AttendanceRecord[]
  notifications    Notification[]
  photos           Photo[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([startAt])
}

// One attendance record per participant per event.
model AttendanceRecord {
  id          String           @id @default(uuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant String           // display name of attendee
  // The SK official marked Present (from the QR attendance page) or Absent.
  officialId  String?
  official    Official?        @relation(fields: [officialId], references: [id], onDelete: SetNull)
  userId      String?          // older check-ins made with an account
  // Optional project link (Form 8 counts the participants from it)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status      AttendanceStatus @default(PRESENT)
  timeIn      DateTime?
  createdAt   DateTime         @default(now())

  // One record per official (and per older account) per event
  @@unique([eventId, officialId])
  @@unique([eventId, userId])
}

// Public news / announcements shown on the home page.
model News {
  id            String     @id @default(uuid())
  title         String
  category      String?
  excerpt       String?
  content       String
  coverImageUrl String?
  authorId      String
  author        User       @relation(fields: [authorId], references: [id])
  status        NewsStatus @default(DRAFT)
  publishedAt   DateTime?
  views         Int        @default(0)
  isFeatured    Boolean    @default(false)
  emailedAt     DateTime?  // set once subscribers were emailed about this article
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
}

// A sign-up waiting for its emailed code. The User row is only created once the code is
// verified, so nobody can register with an address they do not own.
model PendingSignup {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  phone          String?
  passwordHash   String
  receiveUpdates Boolean  @default(false)
  codeHash       String
  codeExpires    DateTime
  attempts       Int      @default(0)
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// A progress photo of a project or an event, shown on the public site.
// Receipt liquidation of an Ongoing project (JPG, PNG or PDF). At least one is needed
// before the project can be marked as completed. Files live in uploads/receipts.
model LiquidationFile {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName       String   // stored file name inside uploads/receipts
  originalName   String
  mimeType       String
  uploadedById   String?
  uploadedByName String?
  // What the receipt says: read by Claude when it is uploaded, or typed by the SK Admin.
  amount         Decimal? @db.Decimal(12, 2)
  receiptDate    DateTime?
  storeName      String?
  readStatus     String?  // PENDING (being read) | READ (read automatically) | FAILED (could not be read) | MANUAL (typed or corrected)
  // The project file module: what the file is (SK_RESOLUTION | ACTIVITY_DESIGN | PURCHASE_REQUEST |
  // RECEIPT | PHOTO | REPORT | LIQUIDATION) and a short description.
  documentType   String   @default("RECEIPT")
  description    String?
  expenses       Expense[]
  createdAt      DateTime @default(now())

  @@index([projectId])
}

// Scanned or signed Purchase Request forms attached to a project (JPG, PNG or PDF).
// Stored in uploads/receipts like the receipts, and served only to the SK side.
model PurchaseRequestFile {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName       String   // stored file name inside uploads/receipts
  originalName   String
  mimeType       String
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([projectId])
}

// Optional checklist of an Ongoing project. When it has items, all of them must be
// checked before the project can be marked as completed.
model ChecklistItem {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label        String
  done         Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Photo {
  id             String   @id @default(uuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  caption        String?
  fileName       String   // stored file name inside server/uploads/photos
  mimeType       String
  uploadedByName String
  uploadedById   String? // the uploader may delete their own picture
  progressUpdates ProgressUpdate[]
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([eventId])
}

// SK information and attendance defaults, edited by the SK Chairperson in Settings → System.
// A single row with id "sk".
model Setting {
  id                 String   @id @default("sk")
  barangayName       String   @default("Barangay Salinas 1, City of Bacoor, Cavite")
  skTerm             String   @default("2023-2026")
  logoFile           String?  // uploaded logo inside server/uploads/photos; empty = the SK seal
  logoType           String?
  qrDefaultBeforeMin Int      @default(30) // QR opens this many minutes before the start
  qrDefaultLengthMin Int?     // QR stays valid this many minutes; empty = until the event ends
  updatedAt          DateTime @updatedAt
}

// ---------- SK project process (Forms 1 to 9) ----------

// Form 1: the SK budget of one year (one record per year).
model AnnualBudget {
  id          String      @id @default(uuid())
  year        Int         @unique
  totalBudget Decimal     @db.Decimal(14, 2)
  fundSource  String      // BARANGAY_GENERAL_FUND_10 | SUPPLEMENTAL | OTHER
  remarks     String?
  items       AbyipItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Form 2: a program or project in the Annual Barangay Youth Investment Program (ABYIP).
// The allotments of a year never exceed that year's SK budget.
model AbyipItem {
  id             String       @id @default(uuid())
  budgetId       String
  budget         AnnualBudget @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  year           Int
  name           String
  center         String       // center of participation
  description    String?
  allottedAmount Decimal      @db.Decimal(14, 2)
  targetQuarter  String       // Q1 | Q2 | Q3 | Q4
  projects       Project[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([year])
}

// Form 3: one row of a project's budget breakdown (total = quantity x unit cost).
model ProjectBudgetRow {
  id           String  @id @default(uuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item         String
  quantity     Decimal @db.Decimal(12, 2)
  unitCost     Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(14, 2)
  displayOrder Int     @default(0)

  @@index([projectId])
}

// Form 4: every decision of the Barangay Chairman on a project request, kept as history.
model ProjectReview {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decision   String   // APPROVE | RETURN | REJECT
  remarks    String?
  reviewerId String?
  reviewer   User?    @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt DateTime @default(now())

  @@index([projectId, reviewedAt])
}

// Form 5: a progress update of an ongoing project; the percentage never goes down.
model ProgressUpdate {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   String
  date        DateTime
  percent     Int
  notes       String?
  photoId     String?
  photo       Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([projectId, date])
}
