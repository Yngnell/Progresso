# PostgreSQL connection string.
# For Neon: copy the connection string from your project dashboard.
# For local Postgres: postgresql://postgres:YOURPASSWORD@localhost:5432/sk_monitoring?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Secret used to sign JWT login tokens. Use a long random string.
JWT_SECRET="change-this-to-a-long-random-secret"

# How long a login token stays valid (e.g. 7d, 24h).
JWT_EXPIRES_IN="7d"

# Port the API runs on.
PORT=5000

# First admin account created by `npm run prisma:seed`.
ADMIN_EMAIL="admin.sksalinas1@gmail.com"
CHAIRMAN_EMAIL="chairman.sksalinas1@gmail.com"
ADMIN_PASSWORD="admin123"

# Email alerts (optional). Project alerts are also emailed to the addresses people save
# in the notification bell. They are sent from this Gmail account using an app password:
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Google Account > Security > App passwords > create one (e.g. named "SK Monitoring").
#   3. Paste the 16-letter app password below (not the normal Gmail password).
# Leave blank to use in-app notifications only.
MAIL_USER=""
MAIL_APP_PASSWORD=""
MAIL_FROM_NAME="SK Monitoring"
# On Railway (outgoing SMTP is blocked on its free/hobby plans) send through Brevo instead:
# BREVO_API_KEY from Brevo > Settings > SMTP & API > API keys; MAIL_FROM_EMAIL = the sender verified in Brevo.
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
# Address of the website, used for the "Open the project" links in the emails and for
# the "Forgot password" reset links (set it to the live site address on Railway).
APP_URL="http://localhost:5173"

# Reads uploaded receipts (amount, date, store) with Claude. Optional: without it the SK Admin types the amounts.
ANTHROPIC_API_KEY=""
