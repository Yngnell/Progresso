# PostgreSQL connection string.
# For Neon: copy the connection string from your project dashboard.
# For local Postgres: postgresql://postgres:YOURPASSWORD@localhost:5432/sk_monitoring?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Secret used to sign JWT login tokens. Use a long random string.
JWT_SECRET="change-this-to-a-long-random-secret"

# How long a login token stays valid (e.g. 7d, 24h).
JWT_EXPIRES_IN="7d"

# Port the API runs on.
PORT=5000

# First admin account created by `npm run prisma:seed`.
ADMIN_EMAIL="admin@sk.gov.ph"
ADMIN_PASSWORD="admin123"
